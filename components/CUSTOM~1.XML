<?xml version="1.0" encoding="utf-8" ?>
<component name="CustomKeyboard" extends="Group">
  <interface>
    <field id="text" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/CustomKeyboard.brs" />
  <children>
    <Rectangle width="410" height="60" color="0x222222FF">
        <Label id="displayText" translation="[15, 15]" size="30" color="0xFFFFFFFF" />
    </Rectangle>
    <MarkupGrid
      id="keyGrid"
      translation="[0, 80]"
      itemComponentName="KeyItem"
      itemSize="[60, 60]"
      itemSpacing="[10, 10]"
      numColumns="6"
      numRows="7"
      drawFocusFeedback="false" />
  </children>
</component>
